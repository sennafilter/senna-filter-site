{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node build-guides.js && node generate-sitemap.js",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/guides-src/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "senna-filter.com" }],
      "destination": "https://www.senna-filter.com/:path*",
      "permanent": true
    }
  ]
}
